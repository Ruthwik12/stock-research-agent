# Copy this file to .env and fill it in. Never commit .env.

# SEC requires a real contact in the User-Agent of every EDGAR request: "Your Name your.email@example.com"
SEC_USER_AGENT=

# Which model the agents use: "anthropic" (Claude, needs the key below) or "ollama" (local qwen3:14b, slow on CPU)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: company news from trusted publishers (free key from finnhub.io). Without it the news step is skipped.
FINNHUB_API_KEY=

# Optional overrides
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:14b
